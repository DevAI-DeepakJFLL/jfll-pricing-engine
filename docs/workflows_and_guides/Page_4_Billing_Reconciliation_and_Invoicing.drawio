</mxCell>
<mxCell id="27" value="&lt;b&gt;Queue for Monthly Hard Copy Dispatch&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Digital soft copy emailed immediately;&lt;br/&gt;Physical stamped invoices dispatched via courier monthly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="860" y="900" width="300" height="70" as="geometry" />
</mxCell>
<mxCell id="28" value="Yes (Physical Required)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#16a34a;fontSize=11;fontStyle=1;" edge="1" source="25" target="27" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="29" value="&lt;b&gt;Dispatch Digital Soft Copy Invoice&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Official invoice PDF emailed on client communication thread;&lt;br/&gt;&lt;b&gt;Completed within strict 2-Day SLA from flight departure&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="1">
  <mxGeometry x="380" y="1010" width="320" height="75" as="geometry" />
</mxCell>
