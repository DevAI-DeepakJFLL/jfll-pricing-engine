<mxCell id="18" value="&lt;b&gt;Issue Draft Invoice (24-Hour SLA)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Draft emailed to agent within 24 hours of execution;&lt;br/&gt;Agent verifies branch billing address, GSTIN &amp; PO numbers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#9a3412;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="860" y="582" width="300" height="75" as="geometry" />
</mxCell>
<mxCell id="19" value="Yes (Multi-Location Agent)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#16a34a;fontSize=11;fontStyle=1;" edge="1" source="16" target="18" parent="1">
