  <mxGeometry x="40" y="140" width="320" height="50" as="geometry" />
</mxCell>
<mxCell id="5" value="&lt;b&gt;Fuel Surcharge (FSC) Policy&lt;/b&gt;&lt;br/&gt;1:1 Pass-Through to Protect Margin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=center;arcSize=8;" vertex="1" parent="1">
