</mxCell>
<mxCell id="22" value="&lt;b&gt;Generate Final Tax Invoice in ERP&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Billing Team raises final tax invoice in system incorporating&lt;br/&gt;verified rates, tax classifications, and billing entity details&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#a855f7;fontColor=#6b21a8;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
