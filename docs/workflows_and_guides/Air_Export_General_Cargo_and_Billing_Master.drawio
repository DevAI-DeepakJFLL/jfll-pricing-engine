<mxCell id="2" value="&lt;b&gt;JET FREIGHT LOGISTICS LIMITED — AIR EXPORT GENERAL CARGO &amp; BILLING SOP&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:normal;&#x27;&gt;End-to-End Workflow: Dynamic Rate Matching, Fuel Surcharge Hedging, Booking Entry, Operational Handover, 3-Way Billing Reconciliation &amp; Invoicing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;fontSize=15;fontStyle=1;align=center;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="40" y="30" width="2060" height="60" as="geometry" />
</mxCell>
<mxCell id="3" value="&lt;b&gt;Governing SOP:&lt;/b&gt; Air Export General Cargo &amp; Billing Workflow &amp;nbsp;|&amp;nbsp; &lt;b&gt;Key Actors:&lt;/b&gt; Pricing Team, Booking Team, Operations, Airlines, Billing Team &amp;nbsp;|&amp;nbsp; &lt;b&gt;Core SLA:&lt;/b&gt; Final Invoicing within 2 Days of Execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#94a3b8;fontSize=11;align=center;arcSize=6;" vertex="1" parent="1">
