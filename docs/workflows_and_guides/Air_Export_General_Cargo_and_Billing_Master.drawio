<mxCell id="20" value="&lt;b&gt;Agent Verification &amp; Adjustments&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Agent confirms draft or requests address corrections;&lt;br/&gt;Billing team incorporates revisions to prevent later rework&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;fontColor=#0f172a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
