  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="25" value="&lt;b&gt;Does Client Specifically&lt;br/&gt;Require Physical&lt;br/&gt;Hard Copy Invoices?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
  <mxGeometry x="420" y="890" width="240" height="90" as="geometry" />
</mxCell>
<mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1" source="22" target="25" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="27" value="&lt;b&gt;Queue for Monthly Hard Copy Dispatch&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Digital soft copy emailed immediately;&lt;br/&gt;Physical stamped invoices dispatched via courier monthly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="860" y="900" width="300" height="70" as="geometry" />
</mxCell>
<mxCell id="28" value="Yes (Physical Required)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#16a34a;fontSize=11;fontStyle=1;" edge="1" source="25" target="27" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="29" value="&lt;b&gt;Dispatch Digital Soft Copy Invoice&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Official invoice PDF emailed on client communication thread;&lt;br/&gt;&lt;b&gt;Completed within strict 2-Day SLA from flight departure&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="1">
  <mxGeometry x="380" y="1010" width="320" height="75" as="geometry" />
</mxCell>
<mxCell id="30" value="No (Digital Default)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=2;fontColor=#dc2626;fontSize=11;fontStyle=1;" edge="1" source="25" target="29" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1" source="27" target="29" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="32" value="&lt;b&gt;Seamless Handoff to Credit Control SOP&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Invoice posted to AR ledger; queued for 7th/22nd statement&lt;br/&gt;dispatch and 30-day payment tracking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="1">
  <mxGeometry x="380" y="1115" width="320" height="65" as="geometry" />
</mxCell>
<mxCell id="33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1" source="29" target="32" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="34" value="&lt;b&gt;DETAILED NOTE B-1: 3-WAY CROSS-TALLY RECONCILIATION DISCIPLINE&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Three Pillars of Verification:&lt;/b&gt; Before raising an invoice, the Billing Team cross-verifies:&lt;br/&gt;  1. &lt;i&gt;Shipment Software Quotation:&lt;/i&gt; Verifies approved buy/sell rates and line items entered by the booking team.&lt;br/&gt;  2. &lt;i&gt;Pricing Team Email Thread:&lt;/i&gt; Confirms customer communication, commercial notes, and final spot rate approvals.&lt;br/&gt;  3. &lt;i&gt;Airline Direct Rates / AWB:&lt;/i&gt; Validates carrier actual chargeable weight, fuel surcharge tier, and war/security fees.&lt;br/&gt;• &lt;b&gt;Preventing Revenue Leakage:&lt;/b&gt; Billing clerks are strictly prohibited from generating invoices on verbal instructions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#f59e0b;fontColor=#1c1917;fontSize=11;fontStyle=0;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="1240" y="160" width="720" height="250" as="geometry" />
</mxCell>
<mxCell id="35" value="&lt;b&gt;DETAILED NOTE B-2: 24-HOUR DRAFT REVIEWS FOR MULTI-LOCATION AGENTS&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Multi-Location Complexities:&lt;/b&gt; Forwarder agents frequently bill cargo across diverse regional entities, branches, and GSTIN registrations depending on destination and client contracts.&lt;br/&gt;• &lt;b&gt;24-Hour Draft Standard:&lt;/b&gt; Sharing draft invoices within 24 hours of flight execution provides a pre-billing review window.&lt;br/&gt;• &lt;b&gt;Operational Impact:&lt;/b&gt; Eliminates costly post-issuance invoice cancellations, credit notes, and administrative delays." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#f59e0b;fontColor=#1c1917;fontSize=11;fontStyle=0;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="1240" y="440" width="720" height="240" as="geometry" />
</mxCell>
<mxCell id="36" value="&lt;b&gt;DETAILED NOTE B-3: INVOICE DELIVERY CHANNELS &amp; THE 2-DAY PERFORMANCE TARGET&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Digital Soft Copy Standard:&lt;/b&gt; 90%+ of invoicing is conducted digitally via soft copy email on the customer communication thread.&lt;br/&gt;• &lt;b&gt;Monthly Physical Dispatch Batch:&lt;/b&gt; Clients requiring physical invoices receive digital copies immediately, while stamped paper copies are couriered on a scheduled &lt;b&gt;monthly basis&lt;/b&gt;.&lt;br/&gt;• &lt;b&gt;Core Performance Target:&lt;/b&gt; The overarching KPI is to raise and dispatch final invoices within &lt;b&gt;two calendar days&lt;/b&gt; of shipment execution.&lt;br/&gt;• &lt;b&gt;Integration with Credit Control:&lt;/b&gt; Invoices generated within this 2-day window feed smoothly into the 7th &amp; 22nd Statement of Accounts (SOA) dispatch cycles." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#f59e0b;fontColor=#1c1917;fontSize=11;fontStyle=0;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="1240" y="710" width="720" height="260" as="geometry" />
</mxCell>
  </root>
</mxGraphModel>
</diagram>
</mxfile>