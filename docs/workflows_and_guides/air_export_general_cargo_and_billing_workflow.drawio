<mxCell id="61" value="&lt;b&gt;Raise Final Tax Invoice&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Final invoice generated per approved rates/address&lt;br/&gt;&lt;b&gt;Target: Within 2 days of shipment execution&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;fontColor=#0f172a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
