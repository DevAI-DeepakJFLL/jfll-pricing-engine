<mxCell id="66" value="&lt;b&gt;Monthly Physical Dispatch Batch&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;If client specifically requires physical hard copy,&lt;br/&gt;they are dispatched on a &lt;b&gt;monthly basis&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;fontColor=#0f172a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
