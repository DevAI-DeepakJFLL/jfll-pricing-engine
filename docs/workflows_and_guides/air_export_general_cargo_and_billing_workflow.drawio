</mxCell>
<mxCell id="68" value="&lt;b&gt;Digital Email Delivery (Soft Copy)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Invoices are primarily handled digitally via email&lt;br/&gt;using soft copies within 2 days of execution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="1">
