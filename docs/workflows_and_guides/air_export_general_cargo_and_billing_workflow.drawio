  <mxGeometry x="280" y="1500" width="200" height="80" as="geometry" />
</mxCell>
<mxCell id="58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1" source="52" target="57" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="59" value="&lt;b&gt;Share Draft Invoice within 24 Hours&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Draft invoice shared for approval within &lt;b&gt;24 hours&lt;/b&gt;&lt;br/&gt;for address adjustments/revisions to minimize rework&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#9a3412;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
